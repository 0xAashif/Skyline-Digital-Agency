# SkyLine Digital Agency — Full-Stack Environment Configuration

# Port for the Express + Vite server (default: 3000)
PORT=3000

# Admin Portal Credentials & JWT Secret
ADMIN_PASSWORD="SkyLine@2026"
JWT_SECRET="skyline-digital-agency-jwt-hmac-secret-2026"

# Optional PostgreSQL / Supabase Connection URL (Prisma Schema in server/prisma/schema.prisma)
